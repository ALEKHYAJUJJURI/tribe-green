{
  "expo": {
    "name": "tribe-green-android",
    "slug": "tribe-green-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "scheme": "tribegreenandroid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon-foreground-1024.png",
        "backgroundImage": "#14532D",
        "monochromeImage": "./assets/splash-icon-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alekhya_jujjuri.tribegreenandroid"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/splash-icon-1024.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8f8aa7f3-eaaf-4ec5-8d67-e9cbf8f37a92"
      }
    }
  }
}
